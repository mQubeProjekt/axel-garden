SELECT
    COALESCE(n.T010ID, a.T010ID) AS T010ID,
    a.T010Bez AS AlterWert,
    n.T010Bez AS NeuerWert,
    CASE
        WHEN a.T010ID IS NULL THEN 'INSERT'
        WHEN n.T010ID IS NULL THEN 'DELETE'
        WHEN a.T010Bez <> n.T010Bez
          OR (a.T010Bez IS NULL AND n.T010Bez IS NOT NULL)
          OR (a.T010Bez IS NOT NULL AND n.T010Bez IS NULL)
            THEN 'UPDATE'
        ELSE 'UNCHANGED'
    END AS DeltaStatus
FROM T010 a
FULL OUTER JOIN T010_Import n
    ON a.T010ID = n.T010ID;
