# Test-AdoConnection.ps1
# Authentifizierung über Microsoft Entra ID
# Es werden KEINE Daten in Azure DevOps verändert.

$organization = "DEINE_ORGANISATION"

# Prüfen, ob Az.Accounts vorhanden ist
if (-not (Get-Module -ListAvailable -Name Az.Accounts)) {
    Write-Host "Az.Accounts ist nicht installiert."
    Write-Host "Installation:"
    Write-Host "Install-Module Az.Accounts -Scope CurrentUser"
    exit
}

Import-Module Az.Accounts

try {

    Write-Host ""
    Write-Host "Microsoft-Anmeldung wird gestartet..."
    Write-Host ""

    # Interaktive Anmeldung mit dem normalen Firmenkonto
    Connect-AzAccount

    Write-Host ""
    Write-Host "Anmeldung erfolgreich."
    Write-Host "Hole Azure-DevOps Access Token..."

    # Token speziell für Azure DevOps anfordern
    $tokenResponse = Get-AzAccessToken `
        -ResourceUrl "https://app.vssps.visualstudio.com/"

    # Aktuelle Az.Accounts-Version liefert das Token als SecureString
    $ptr = [Runtime.InteropServices.Marshal]::SecureStringToBSTR(
        $tokenResponse.Token
    )

    try {
        $accessToken =
            [Runtime.InteropServices.Marshal]::PtrToStringBSTR($ptr)

        $headers = @{
            Authorization = "Bearer $accessToken"
            Accept        = "application/json"
        }

        $uri =
            "https://dev.azure.com/$organization/_apis/projects?api-version=7.2"

        Write-Host ""
        Write-Host "Connecting to Azure DevOps..."
        Write-Host "Organization: $organization"
        Write-Host ""

        $result = Invoke-RestMethod `
            -Uri $uri `
            -Method Get `
            -Headers $headers

        Write-Host "Connection successful."
        Write-Host ""
        Write-Host "Accessible projects:"
        Write-Host "--------------------"

        foreach ($project in $result.value) {
            Write-Host "$($project.name) [$($project.state)]"
        }
    }
    finally {
        if ($ptr -ne [IntPtr]::Zero) {
            [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($ptr)
        }

        $accessToken = $null
    }
}
catch {
    Write-Host ""
    Write-Host "Connection failed."
    Write-Host $_.Exception.Message
}
