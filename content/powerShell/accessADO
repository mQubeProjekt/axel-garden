$organization = "basf4ServicesCoreSystems"
$project      = "enviData"
$workItemType = "Task"

$securePat = Read-Host "Azure DevOps PAT eingeben" -AsSecureString
$ptr = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($securePat)

try {
    $pat = [Runtime.InteropServices.Marshal]::PtrToStringBSTR($ptr)

    $base64AuthInfo = [Convert]::ToBase64String(
        [Text.Encoding]::ASCII.GetBytes(":$pat")
    )

    $headers = @{
        Authorization  = "Basic $base64AuthInfo"
        "Content-Type" = "application/json-patch+json"
    }

    $body = @(
        @{
            op    = "add"
            path  = "/fields/System.Title"
            value = "Test Task from PowerShell"
        },
        @{
            op    = "add"
            path  = "/fields/System.Description"
            value = "This task was created automatically via PowerShell."
        }
    ) | ConvertTo-Json

    $uri = "https://dev.azure.com/$organization/$project/_apis/wit/workitems/`$$workItemType?api-version=7.1"

    Write-Host "Creating Work Item..."

    $result = Invoke-RestMethod `
        -Uri $uri `
        -Method Post `
        -Headers $headers `
        -Body $body

    Write-Host ""
    Write-Host "Work Item created successfully."
    Write-Host "ID: $($result.id)"
    Write-Host "Title: $($result.fields.'System.Title')"
    Write-Host "URL: $($result._links.html.href)"
}
catch {
    Write-Host ""
    Write-Host "Creation failed:"
    Write-Host $_.Exception.Message
}
finally {
    if ($ptr -ne [IntPtr]::Zero) {
        [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($ptr)
    }

    $pat = $null
}

Pause
